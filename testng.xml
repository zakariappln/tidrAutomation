<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  UI SUITE (group / tag based) - plain TestNG UI tests + Gherkin scenarios from features/ui.
  Run:   mvn clean test -Dsuite=testng.xml                      -> smoke + regression (Cucumber: not @wip)
         mvn clean test -Dsuite=testng.xml -Dgroups=smoke       -> TestNG group smoke, Cucumber tags (@smoke) and not @wip
         mvn clean test -Dsuite=testng.xml -Dgroups=login,smoke
  Surefire's -Dgroups overrides the <groups> blocks below; 'wip' is always excluded.
-->
<suite name="PPLN UI Suite"
       parallel="methods"
       thread-count="4"
       data-provider-thread-count="4"
       verbose="1"
       configfailurepolicy="continue">

  <listeners>
    <listener class-name="com.ppln.automation.core.listeners.TestListener"/>
    <listener class-name="com.ppln.automation.core.listeners.SuiteListener"/>
    <listener class-name="com.ppln.automation.core.listeners.AnnotationTransformer"/>
    <!-- io.qameta.allure.testng.AllureTestNg is wired automatically by allure-testng (META-INF/services);
         listing it here again only produces "Ignoring duplicate listener" warnings. -->
  </listeners>

  <test name="UI Tests (TestNG)" preserve-order="false">
    <groups>
      <define name="ui-default">
        <include name="smoke"/>
        <include name="regression"/>
      </define>
      <run>
        <include name="ui-default"/>
        <exclude name="wip"/>
        <exclude name="api"/>
      </run>
    </groups>
    <packages>
      <package name="com.ppln.automation.ui.tests.*"/>
    </packages>
  </test>

  <test name="UI Scenarios (Gherkin)" preserve-order="false">
    <groups>
      <run>
        <include name="smoke"/>
        <include name="regression"/>
        <exclude name="wip"/>
      </run>
    </groups>
    <classes>
      <class name="com.ppln.automation.ui.bdd.RunUiCucumberTest"/>
    </classes>
  </test>

</suite>
