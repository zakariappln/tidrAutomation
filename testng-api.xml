<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  API SUITE - plain TestNG API tests + Gherkin scenarios from features/api + glue self-tests.
  Run:   mvn clean test -Dsuite=testng-api.xml
         mvn clean test -Dsuite=testng-api.xml -Dgroups=smoke
         mvn clean test -Dsuite=testng-api.xml -Dcucumber.execution.dry-run=true   (glue gate)
  parallel="classes": one APIRequestContext per class per thread (BaseApiTest); scenarios run in
  parallel through the runner's data provider (data-provider-thread-count).
-->
<suite name="PPLN API Suite"
       parallel="classes"
       thread-count="8"
       data-provider-thread-count="8"
       verbose="1"
       configfailurepolicy="continue">

  <listeners>
    <listener class-name="com.ppln.automation.core.listeners.TestListener"/>
    <listener class-name="com.ppln.automation.core.listeners.SuiteListener"/>
    <listener class-name="com.ppln.automation.core.listeners.AnnotationTransformer"/>
    <!-- io.qameta.allure.testng.AllureTestNg is wired automatically by allure-testng (META-INF/services);
         listing it here again only produces "Ignoring duplicate listener" warnings. -->
  </listeners>

  <test name="API Tests (TestNG)" preserve-order="false">
    <groups>
      <run>
        <include name="api"/>
        <exclude name="wip"/>
      </run>
    </groups>
    <packages>
      <package name="com.ppln.automation.api.tests.*"/>
    </packages>
  </test>

  <test name="API Scenarios (Gherkin)" preserve-order="false">
    <groups>
      <run>
        <include name="api"/>
        <exclude name="wip"/>
      </run>
    </groups>
    <classes>
      <class name="com.ppln.automation.api.bdd.RunApiCucumberTest"/>
    </classes>
  </test>

  <test name="Glue self-tests (unit)" preserve-order="false">
    <groups>
      <run>
        <include name="unit"/>
      </run>
    </groups>
    <packages>
      <package name="com.ppln.automation.core.config"/>
      <package name="com.ppln.automation.core.bdd"/>
      <package name="com.ppln.automation.api.bdd.context"/>
      <package name="com.ppln.automation.api.client"/>
    </packages>
  </test>

</suite>
